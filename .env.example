# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit this.
# Used only to let an Admin create user accounts (app/(app)/admin/users/actions.ts).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public URL of the deployed site (used for the QR code of the self-registration link)
# Public address of the site, used in the registration QR code. On Vercel set it to your real
# address (for example https://your-site.vercel.app). If it is left as localhost on a deployed site,
# the QR code uses the address the Registrations page is open on instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
